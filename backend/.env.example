# Copy to backend/.env and fill in real values. This file is gitignored —
# never commit real credentials, only this placeholder template.

# MongoDB Atlas (or any Mongo) connection string. The app only ever reads
# from / writes to the single database named by MONGODB_DB_NAME below —
# never touches sibling databases on a shared cluster.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=harness_arena

UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
ARENA_CACHE_PREFIX=harness-arena:local:v1

# The account allowed to manage shared OnDemand/free provider profiles.
ARENA_ADMIN_USERNAME=ondemand
ARENA_SESSION_SECRET=replace-with-a-long-random-secret-in-production

# Refresh-session cookie. These values are for local HTTP development.
# Production split-domain deployments must use true/none and an exact
# ARENA_CORS_ORIGINS value for the frontend domain.
ARENA_COOKIE_SECURE=false
ARENA_REFRESH_COOKIE_SAMESITE=lax
# ARENA_CORS_ORIGINS=https://your-frontend.example.com

# SendGrid's HTTPS API is used for email-verification codes. The sender
# must be a verified Sender Identity in SendGrid. Keep the API key only in
# backend/.env or your deployment secrets, never in Git.
SENDGRID_API_KEY=SG.your-new-sendgrid-api-key
SENDGRID_FROM_EMAIL=your email

# Optional: sets the account password scripts/import_seed_results.py uses
# for the seeded "ondemand" submitter (same name as the default arena admin
# account — see that script). Leave unset and a random one is generated and
# printed once when the account is first created.
# ARENA_SEED_USER_PASSWORD=change-me

# --- Live previews for web-development tasks (optional) ---------------
# A task whose deliverables are a runnable web project (see
# app/webproject.py) gets a "View website" action that deploys its
# frontend to an ephemeral Vercel Sandbox. Without these three set, the
# arena still works — those runs simply offer the source zip instead of
# a live preview (see app/sandbox_deploy.py's preview_unavailable_reason).
#
# Uses Vercel's official Python SDK (the `vercel` package in
# requirements.txt) — no Node runtime or global CLI needed on the server.
#
# Use a Vercel token scoped as narrowly as the account allows: it can
# create sandboxes that execute model-generated code and bills for their
# runtime. Never commit the real values.
# VERCEL_TOKEN=your-vercel-token
# VERCEL_TEAM_ID=team_xxxxxxxx
# VERCEL_PROJECT_ID=prj_xxxxxxxx
#
# Optional overrides (defaults shown):
# ARENA_SANDBOX_TIMEOUT_SECONDS=5400
# ARENA_SANDBOX_IMAGE=
# ARENA_SANDBOX_VCPUS=1
